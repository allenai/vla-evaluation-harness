# LADDER RoboLab-Long evaluation environment (Isaac Sim 6.0 / Isaac Lab 3.0, Python 3.12)

ARG BASE_IMAGE=ghcr.io/allenai/vla-evaluation-harness/base:latest
FROM ${BASE_IMAGE}

ARG ACCEPT_NVIDIA_EULA
RUN if [ "$ACCEPT_NVIDIA_EULA" != "YES" ]; then \
        echo "Building the ladder_robolab image requires accepting the NVIDIA Isaac Sim EULA:"; \
        echo "  https://docs.omniverse.nvidia.com/eula/"; \
        echo "Re-run with: docker/build.sh ladder_robolab --accept-license ladder_robolab"; \
        exit 1; \
    fi

RUN conda create -n ladder_robolab python=3.12 pip -y && conda clean -afy

SHELL ["conda", "run", "-n", "ladder_robolab", "/bin/bash", "-c"]

WORKDIR /app
ARG LADDER_REF=6c88eea
RUN mkdir -p /app/ladder \
    && cd /app/ladder \
    && git init -q \
    && git remote add origin https://github.com/insait-institute/ladder.git \
    && git fetch -q --depth 1 origin "${LADDER_REF}" \
    && git checkout -q FETCH_HEAD \
    && rm -rf .git

# Vendor RoboLab source + assets + openpi_client image tools from LADDER v1.0.0 release
RUN mkdir -p /app/robolab_src /app/openpi_src /app/ladder/ladder/components/inference/robots/robolab/assets \
    && curl -fsSL https://github.com/insait-institute/ladder/releases/download/v1.0.0/robolab_src.tar.gz \
       | tar -xz --strip-components=1 -C /app/robolab_src \
    && patch -p1 -d /app/robolab_src < /app/ladder/build_support/python/patches/robolab_constants_asset_dir.patch \
    && curl -fsSL https://github.com/insait-institute/ladder/releases/download/v1.0.0/robolab_assets.tar.gz \
       | tar -xz --strip-components=1 -C /app/ladder/ladder/components/inference/robots/robolab/assets \
    && curl -fsSL https://github.com/insait-institute/ladder/releases/download/v1.0.0/openpi_src.tar.gz \
       | tar -xz --strip-components=1 -C /app/openpi_src

RUN uv pip install --no-cache-dir --prerelease=allow \
        --extra-index-url https://pypi.nvidia.com \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
        "isaacsim[all,extscache]==6.0.0.1" \
        "isaaclab[isaacsim]==3.0.0b2" \
        "torch==2.11.0+cu128" \
        "torchvision==0.26.0+cu128" \
        "pytorch-kinematics==0.7.6" \
        h5py imageio imageio-ffmpeg json_numpy matplotlib pandas python-dotenv requests "setuptools<81" tyro websockets \
    && uv pip install --no-cache-dir --no-deps /app/openpi_src/packages/openpi-client

ENV LADDER_ROOT=/app/ladder
ENV PYTHONPATH=/app/robolab_src:/app/ladder:/app/ladder/build_support/python
ENV ROBOLAB_ASSET_DIR=/app/ladder/ladder/components/inference/robots/robolab/assets
ENV OMNI_KIT_ACCEPT_EULA=YES

WORKDIR /workspace
COPY pyproject.toml README.md ./
COPY src/ src/
ARG HARNESS_VERSION=0.0.0
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${HARNESS_VERSION}
RUN uv pip install --no-cache-dir -e .
COPY configs/ configs/

ENTRYPOINT ["conda", "run", "--no-capture-output", "-n", "ladder_robolab", "vla-eval"]
CMD ["run", "--config", "/workspace/configs/benchmarks/ladder/robolab_smoke.yaml"]
